<Project>
  <PropertyGroup>
    <!-- Game install folder; override with: dotnet build -p:OMDir="D:\Games\Opus Magnum" -->
    <OMDir Condition="'$(OMDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Opus Magnum</OMDir>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>

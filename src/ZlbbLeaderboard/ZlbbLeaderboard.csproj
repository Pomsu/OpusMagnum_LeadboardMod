<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <AssemblyName>ZlbbLeaderboard</AssemblyName>
    <RootNamespace>ZlbbLeaderboard</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.5.2 reference assemblies are not installed with the .NET SDK -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- ModdedLightning.exe already contains Quintessential (merged by MonoMod) -->
    <Reference Include="Lightning">
      <HintPath>$(OMDir)\ModdedLightning.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_ModdedLightning">
      <HintPath>$(OMDir)\MMHOOK_ModdedLightning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(OMDir)\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(OMDir)\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(OMDir)\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="quintessential.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
